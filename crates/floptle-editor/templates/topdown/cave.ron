        (
            id: Some(12),
            name: "Game",
            transform: (translation: (0.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0, 1.0), scale: (1.0, 1.0, 1.0)),
            matter: Empty,
            // A fresh inventory node — which reads back the same save store, so
            // it already knows about the key you picked up in the village.
            scripts: [(kind: "inventory")],
        ),
        (
            id: Some(20),
            name: "Hermit",
            transform: (translation: (-3.0, 1.2, -6.0), rotation: (0.0, 0.0, 0.0, 1.0), scale: (1.0, 1.0, 1.0)),
            matter: Primitive(shape: Capsule, color: (0.6, 0.62, 0.7)),
            scripts: [(kind: "npcTalk", params: [("range", 3.0)], strs: [("lines", "You got the door open, then.|Nobody has been down here in years.|There is nothing left. That is rather the point."), ("prompt", "E — talk")])],
        ),
        (
            id: Some(30),
            name: "Door",
            transform: (translation: (0.0, 1.5, 11.5), rotation: (0.0, 0.0, 0.0, 1.0), scale: (3.0, 3.0, 1.0)),
            matter: Primitive(shape: Cube, color: (0.4, 0.33, 0.28)),
            rigidbody: Some((boxed: true, mode: Kinematic, gravity: false, half_extents: (0.5, 0.5, 0.5))),
            trigger: true,
            // The way back. An empty `needs` is a door with no lock.
            scripts: [(kind: "door", strs: [("destination", "first"), ("needs", ""), ("refusal", "")])],
        ),
    ],
)
