// Paper: warm, low-glare light. Ink on cream, a terracotta accent.
(
    format: 1,
    id: "paper",
    name: "Paper",
    author: "Fopull",
    description: "Warm cream and ink: a light theme with less glare.",
    extends: "floptle-light",
    colors: (
        ground: "#f1eadc70",
        surface: "#f9f4e9",
        surface_2: "#e7ddc9",
        well: "#fffaf0",
        hairline: "#d5c7ac",
        hairline_quiet: "#e3d8c2",
        text: "#2a241d",
        dim: "#5f5547",
        faint: "#8f8370",
        accent: "#a8471f",
        accent_hi: "#863615",
        on_accent: "#fffaf0",
        backdrop: "#e5dbc6",
    ),
    code: (
        background: "#fffaf0",
        gutter: "#b0a48e",
        keyword: "#9a2f50",
        api: "#245f8a",
        string: "#4f6b14",
        number: "#8a4b0f",
        comment: "#8f8370",
        text: "#2a241d",
        current_line: "#5a3c1012",
    ),
    shape: (radius: 8, radius_small: 5, widget_radius: 5),
    surfaces: {
        "ground": (layers: [Gradient(stops: [(0.0, "#f6f0e3"), (1.0, "#e9dfcb")], radial: true)]),
    },
)
