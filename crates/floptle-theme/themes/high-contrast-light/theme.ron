// High Contrast Light: black on white, the same bold edges and larger text.
(
    format: 1,
    id: "high-contrast-light",
    name: "High Contrast Light",
    author: "Fopull",
    description: "Maximum legibility for bright rooms: black on white.",
    extends: "high-contrast",
    dark: false,
    colors: (
        ground: "#ffffff",
        surface: "#ffffff",
        surface_2: "#ececec",
        well: "#ffffff",
        hairline: "#000000",
        hairline_quiet: "#6b6b6b",
        text: "#000000",
        dim: "#1c1c1c",
        faint: "#3a3a3a",
        accent: "#0038b8",
        accent_hi: "#002a8c",
        on_accent: "#ffffff",
        backdrop: "#ffffff",
        selection: "$accent/25%",
    ),
    code: (
        background: "#ffffff",
        gutter: "#3a3a3a",
        keyword: "#0038b8",
        api: "#8a0063",
        string: "#005c14",
        number: "#7a2e00",
        comment: "#3a3a3a",
        text: "#000000",
        current_line: "#0000001a",
    ),
)
