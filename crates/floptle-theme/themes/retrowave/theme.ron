// Retrowave: a neon sunset over an endless grid. Square corners, hot pink,
// electric cyan.
(
    format: 1,
    id: "retrowave",
    name: "Retrowave",
    author: "Fopull",
    description: "Neon sunset and an endless grid, square corners.",
    colors: (
        ground: "#0f032680",
        surface: "#170838f2",
        surface_2: "#240d4dd0",
        well: "#0a0219eb",
        hairline: "#4b1f7a",
        hairline_quiet: "#33155a",
        text: "#fdf0ff",
        dim: "#cfa6e8",
        faint: "#9068b0",
        accent: "#ff3fd2",
        accent_hi: "#ffa3ec",
        on_accent: "#24001d",
        backdrop: "#07011a",
        selection: "$accent/30%",
    ),
    code: (
        background: "#0a0219",
        gutter: "#6a3f90",
        keyword: "#ff7be0",
        api: "#3ff0ff",
        string: "#ffd36b",
        number: "#ff9f5a",
        comment: "#9068b0",
        text: "#fdf0ff",
    ),
    fonts: (display_weight: 800),
    shape: (radius: 0, radius_small: 0, widget_radius: 0),
    surfaces: {
        "ground": (layers: [Shader(shader: "builtin:grid", colors: ["#ff3fd2", "#3ff0ff", "#12033a", "#ffd36b"])]),
    },
)
