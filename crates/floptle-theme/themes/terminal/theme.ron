// Terminal: a green phosphor screen. Everything in mono, square corners,
// scanlines behind the panels.
(
    format: 1,
    id: "terminal",
    name: "Terminal",
    author: "Fopull",
    description: "Green phosphor, all monospace, scanlines.",
    colors: (
        ground: "#020a0480",
        surface: "#03100af5",
        surface_2: "#082011d8",
        well: "#010703f0",
        hairline: "#1a5a2c",
        hairline_quiet: "#0f3a1c",
        text: "#b9ffc8",
        dim: "#6fd48a",
        faint: "#3f8f55",
        accent: "#3dff7a",
        accent_hi: "#a6ffc0",
        on_accent: "#001a08",
        backdrop: "#010502",
        selection: "$accent/28%",
    ),
    code: (
        background: "#010703",
        gutter: "#2f6f42",
        keyword: "#a6ffc0",
        api: "#5ff5e0",
        string: "#e8ff8a",
        number: "#ffd27a",
        comment: "#3f8f55",
        text: "#b9ffc8",
    ),
    fonts: (ui: "IBM Plex Mono", display: "IBM Plex Mono", size: 12.5, mono_size: 12.5),
    shape: (radius: 0, radius_small: 0, widget_radius: 0, density: 0.95),
    surfaces: {
        "ground": (layers: [Shader(shader: "builtin:scanlines", speed: 0.6, colors: ["#3dff7a", "#3dff7a", "#010a04", "#ffffff"])]),
    },
)
