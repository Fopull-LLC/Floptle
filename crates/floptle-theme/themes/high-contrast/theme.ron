// High Contrast: white on black, bright borders on everything you can
// touch, a yellow you cannot miss, and a face drawn to keep similar
// letters apart. Larger text, and no animation.
(
    format: 1,
    id: "high-contrast",
    name: "High Contrast",
    author: "Fopull",
    description: "Maximum legibility: white on black, bold edges, larger text.",
    dark: true,
    colors: (
        ground: "#000000",
        surface: "#000000",
        surface_2: "#161616",
        well: "#000000",
        hairline: "#f2f2f2",
        hairline_quiet: "#8c8c8c",
        text: "#ffffff",
        dim: "#e6e6e6",
        faint: "#c8c8c8",
        accent: "#ffd60a",
        accent_hi: "#ffe766",
        accent_wash: "$accent/20%",
        accent_edge: "$accent",
        on_accent: "#000000",
        backdrop: "#000000",
        selection: "$accent/38%",
    ),
    code: (
        background: "#000000",
        gutter: "#c8c8c8",
        keyword: "#ffd60a",
        api: "#5fe3ff",
        string: "#9dff8a",
        number: "#ff9cf0",
        comment: "#c8c8c8",
        text: "#ffffff",
        current_line: "#ffffff1f",
    ),
    fonts: (
        ui: "Atkinson Hyperlegible",
        display: "Atkinson Hyperlegible",
        ui_weight: 460,
        display_weight: 760,
        size: 14.5,
        mono_size: 14,
    ),
    shape: (radius: 4, radius_small: 3, widget_radius: 3, stroke: 2, density: 1.12),
    motion: (animation_ms: 0),
)
