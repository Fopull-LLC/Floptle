// One row of the demo's manifest list.
//
// The repeater on "Manifest List" spawns one of these per row and destroys the
// extras. Nothing here knows how many rows there are — the row asks
// `node.index` who it is and fills itself in.
[
    (
        name: "DemoRow",
        transform: (
            translation: (0.0, 0.0, 0.0),
            rotation: (0.0, 0.0, 0.0, 1.0),
            scale: (1.0, 1.0, 1.0),
        ),
        matter: Empty,
        scripts: [
            (
                kind: "ui_demo_row",
                enabled: true,
                params: [],
            ),
        ],
        ui: Some((
            place: Free(pos: (0.0, 0.0)),
            size: (Fixed(346.0), Fixed(34.0)),
            text: Some((
                text: "",
                size: 18.0,
                color: (0.56, 0.6, 0.68, 1.0),
                align: Start,
                valign: Center,
                fit: false,
            )),
            button: true,
            focusable: true,
            group: "manifest",
            style: "row",
        )),
    ),
]
