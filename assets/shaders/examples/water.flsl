// Water — drop it on a flat plane (or anything). Warped noise rolls the
// surface, the fresnel angle blends deep water into shallow, crests sparkle,
// and it foams wherever anything comes near the surface — no masks, no setup.
//
// The foam reads TWO things and takes whichever is closer, which is what makes
// it work in a real scene:
//   surfaceGap()     — the mesh geometry behind the water: rocks you modelled,
//                      a jetty, a boat's hull, a dropped crate.
//   fieldDistance()  — the SDF field: terrain and blobs.
// Between them nothing in the scene is invisible to the shoreline, and neither
// one needs you to mark anything up.
shader water {
  stage fragment
  blend alpha
  uniform shallowColor: color = #3EC6C8
  uniform deepColor: color = #14395C
  uniform speed: float = 0.6 range(0, 3)
  uniform waveScale: float = 4 range(0.5, 20)
  // How far from the shore the foam reaches, in world units.
  uniform foam: float = 0.5 range(0, 4)
  // How hard its edge is: 0 fades all the way out, 1 is a crisp waterline.
  uniform foamEdge: float = 0.35 range(0, 1)
  // How much the waves eat into the foam — what stops the edge reading as a
  // painted-on band and starts it reading as surf.
  uniform foamNoise: float = 0.5 range(0, 1)
  uniform clarity: float = 0.75 range(0.2, 1)

  let flow = uv * waveScale + vec2(time * speed * 0.13, time * speed * 0.11)
  let waves = fbm(domainWarp(flow, scale: 1.5, time: time * speed * 0.2), octaves: 4) * 0.5 + 0.5
  let crest = smoothstep(0.62, 0.95, waves)
  let facing = pow(1 - saturate(dot(normal, viewDir)), 2)
  let body = mix(deepColor.rgb, shallowColor.rgb, facing * 0.6 + waves * 0.3)

  // Whichever is nearer: the mesh behind, or the SDF field.
  let gap = min(surfaceGap(worldPos), fieldDistance(worldPos))
  // The waves ride the shoreline, so the band breathes with the surface.
  let nearness = 1 - saturate(gap / (foam + 0.001)) - (waves - 0.5) * foamNoise * 0.5
  let shore = smoothstep(1 - foamEdge - 0.001, 1, saturate(nearness) + foamEdge)

  let lit = litSurface(body + crest * 0.35 + shore * 0.9)

  // Thin water is see-through: right where it meets the shore it all but
  // vanishes, which is what sells the edge as water rather than a decal.
  let thin = saturate(gap / (foam * 2 + 0.001))
  output color = vec4(lit, (clarity + facing * (1 - clarity)) * thin) * instanceColor
}
