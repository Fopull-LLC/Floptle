(
    id: "com.fopull.fofighterkit",
    name: "Fofighter Sample Kit",
    version: "1.0.0",
    description: "Characters, music, a display face and a procedural sky, lifted straight out of Fofighter and released into the public domain. Drop them in a project and use them for anything — a prototype that needs something on screen, a test scene, or a shipped game.",
    author: (name: "Fopull", url: "https://fopull.com"),
    license: "CC0-1.0",
    keywords: ["characters", "low-poly", "stylised", "music", "font", "skybox", "public-domain"],
    categories: [Art3D, Audio, Fonts, Shaders],
    thumbnail: "media/thumb.png",
    banner: "media/banner.jpg",
    media: [
        (image: "media/01_cast.jpg", caption: "Four rigged characters and a prop, at the same scale"),
        (image: "media/02_sky.jpg", caption: "The ashfall sky across its one knob: void, embers, the skyline, the fire, engulfed"),
        (image: "media/03_font.jpg", caption: "Fofighter — the game's display face"),
        (image: "media/04_music.jpg", caption: "Four tracks: a fight theme, a menu loop, a story beat and an exposition cue"),
        (image: "media/05_elvira.jpg", caption: "Elvira"),
        (image: "media/06_elle.jpg", caption: "Elle"),
        (image: "media/07_sae.jpg", caption: "Sae — rigged, 17 parts"),
        (image: "media/08_jester.jpg", caption: "The Disgraced Jester, authored in a defeated pose"),
        (image: "media/09_rapier.jpg", caption: "Sae's rapier"),
    ],
    engine: ">=0.55.0",
)
