(
    id: "com.floptle.scenereport",
    name: "Scene Report",
    version: "1.1.0",
    description: "Counts what is in the open scene, marks the big things in the Scene view, and shows what is selected. A small, complete example of an editor extension.",
    author: (name: "Fopull", url: "https://fopull.com"),
    license: "MIT OR Apache-2.0",
    keywords: ["example", "editor-tools"],
    categories: [EditorTool],
    thumbnail: "media/thumb.png",
    banner: "media/banner.jpg",
    media: [
        (image: "media/editor.jpg", caption: "The editor with a project open — Scene Report lives alongside everything else"),
        (image: "media/viewport.jpg", caption: "It marks the big things in the Scene view, where you are already looking"),
        (image: "media/panel.jpg", caption: "A panel of its own, built entirely from the editor's Lua API"),
    ],
    engine: ">=0.55.0",
)
