# Rust
/target
**/*.rs.bk
# Cargo.lock is committed: this workspace produces binaries.

# Editor / OS scratch
*.swp
.DS_Store
Thumbs.db
.idea/

# Machine-specific cargo config (target-dir differs per machine).
.cargo/config.toml

# Dev screenshots and capture shares.
/Screenshots/

# CI-built engine binaries consumed by Export Game (see docs/export-builds.md).
/prebuilt/

# Local placeholder assets that never ship.
assets/textures/_oot_temp/
assets/**/_oot_temp/
assets/models/_test/

# Generated binary assets (import caches, bakes).
assets/.cache/
*.blend1
out.png

# Terrain fields are streaming data, regenerated deterministically from the
# scene; player edits persist in save slots. A single field can exceed 100 MB.
*.cfield
*.tfield
**/terrain/*.meta

# Runtime data written by the engine while a game runs.
**/saves/
**/.floptle/autosave/
/*/save/
/*/replays/

# Auto-seeded UI effect examples in the default project (regenerated on open).
assets/shaders/examples/ui/

# The Solar demo lives in its own repository (github.com/Fopull-LLC/Solar); a
# local symlink here keeps older project paths working.
/solar

# A project's package registry records absolute paths on the machine that
# linked them.
/*/packages.ron

# Offscreen render-probe outputs, and ad-hoc screenshots at the repo root.
*_probe.png
/*.png
!/docs/**/*.png

# Agent tooling state and internal working notes.
.claude/
/.internal/
/CLAUDE.md

# Python bytecode from helper scripts.
__pycache__/
*.pyc
.venv/

# Local packaging output (scripts/package.sh); real releases are built by CI.
/dist/
/builds/
builds.zip

# Source-art archives dropped at the repo root while working.
/*.zip

# Script-VM comparison builds from scripts/scene-bench.sh.
/.bench/
